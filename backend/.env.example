# Kopiraj u .env i popuni. Server odbija start ako JWT_SECRET ili MONGODB_URI nedostaju.

# ── obavezno ───────────────────────────────────────────────────────
# Dugačak nasumičan niz. Generiraj s:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Ime baze se čita iz putanje URI-ja ako DB_NAME nije postavljen
MONGODB_URI=mongodb://localhost:27017/ucilica

# ── neobavezno ─────────────────────────────────────────────────────
# DB_NAME=ucilica
# PORT=3000
# NODE_ENV=development
# JWT_EXPIRES_IN=7d

# U produkciji obavezno suzi na vlastitu domenu umjesto '*'
# CORS_ORIGIN=https://mudrolina.example.hr

# Broj reverse proxyja ispred aplikacije (Caddy, nginx, Render…). U produkciji
# je zadano 1; postavi 0 ako je Node izravno na internetu.
# TRUST_PROXY=1

# Koliko dana se pitanje smatra „nedavno viđenim” (uz najmanje zadnjih 10 kvizova teme).
# UCILICA_VIDJENO_DANA=30

# ── prijava pogrešnog pitanja (gumb „Prijavi pitanje”) ──────────────
# Prijave se uvijek spremaju u zbirku `prijave`. Ako je SMTP podešen, šalju se
# i e-poštom; e-adresa roditelja iz profila ide u Reply-To.
# PRIJAVE_EMAIL=contact@fromrim.com
# SMTP_HOST=smtp.example.hr
# SMTP_PORT=587
# Za port 465 postavi SMTP_SECURE=true
# SMTP_SECURE=false
# SMTP_USER=mudrolina@fromrim.com
# SMTP_PASS=
# MAIL_FROM="Mudrolina <mudrolina@fromrim.com>"
